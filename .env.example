# Optional. Without either key, "Ask the model" falls back to the heuristic.
# If both are set, AI Gateway is used.

# Vercel AI Gateway — model ids look like openai/gpt-5.4-mini
AI_GATEWAY_API_KEY=

# Direct OpenAI — model ids look like gpt-5.4-mini
OPENAI_API_KEY=

# Optional override for either provider.
AI_MODEL=
